# ──────────────────────────────────────────────────────────────────
#  GradeWise Backend — Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit the real .env file — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────

# Required: Google Gemini API key
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Deployed Vercel frontend URL used to restrict CORS in production.
# Leave blank during local development (all origins are allowed).
# Example: https://gradewise.vercel.app
FRONTEND_URL=
